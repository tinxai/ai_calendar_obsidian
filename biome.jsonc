{
	"$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		// main.js는 번들 산출물이고 package-lock.json은 npm이 만든다.
		"includes": ["**", "!main.js", "!package-lock.json"]
	},
	"formatter": {
		// 들여쓰기와 줄 끝 문자는 .editorconfig를 따른다.
		"useEditorconfig": true,
		// 기본값 80은 이 저장소가 쓰던 줄 길이보다 짧아 재배치 폭이 지나치게 커진다.
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single"
		}
	},
	"linter": {
		"rules": {
			"suspicious": {
				// `const x = (this.y = f())`와 `if ((m = s.match(re)))`는
				// view.ts와 e2e 가짜 서버가 의도적으로 쓰는 관용구다.
				"noAssignInExpressions": "off"
			}
		}
	}
}
